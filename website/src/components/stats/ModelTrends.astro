---
// One small chart a model, month by month: its devices asked about for a
// readout, read out, and converted, each a line, on one scale for every
// model so they read against each other. A month under the smallest figure
// is drawn as none. `rows` the figures' modelMonths, `months` the months
// shown, oldest first.
const { rows, months } = Astro.props;
const series = [["asked", "Asked to be read out", "series-1"], ["readOut", "Read out", "series-2"],
  ["converted", "Converted", "series-3"]];
const byModel = new Map();
for (const row of rows) {
  (byModel.get(row.model) ?? byModel.set(row.model, new Map()).get(row.model)).set(row.month, row);
}
const total = (model) => [...model.values()].reduce((sum, row) => sum + series.reduce((n, [key]) => n + (row[key] ?? 0), 0), 0);
const models = [...byModel].sort(([a, x], [b, y]) => total(y) - total(x) || a.localeCompare(b));
// The legend names only the series some model has: a key for nothing is noise.
const present = series.filter(([key]) => rows.some((row) => row[key]));
const top = Math.max(1, ...rows.flatMap((row) => series.map(([key]) => row[key] ?? 0)));
const [W, H, left, bottom, topPad] = [300, 130, 34, 24, 12];
const x = (index) => left + ((W - left - 6) * index) / Math.max(1, months.length - 1);
const y = (value) => topPad + (H - topPad - bottom) * (1 - value / top);
const label = (month) => new Date(`${month}-01T00:00:00Z`).toLocaleString("en", { month: "short", year: "numeric", timeZone: "UTC" });
---
<figure class="chart">
  <ul class="legend">
    {present.map(([, name, colour]) => <li><span class={`swatch ${colour}`}></span>{name}</li>)}
  </ul>
  <div class="trends">
    {models.map(([model, byMonth]) => (
      <figure class="trend">
        <figcaption>{model}</figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${model}: devices each month`}>
          <line class="grid" x1={left} x2={W} y1={y(0)} y2={y(0)} />
          <text class="tick" x={left - 6} y={y(top) + 4} text-anchor="end">{top.toLocaleString("en")}</text>
          {present.map(([key, name, colour]) => {
            const values = months.map((month) => byMonth.get(month)?.[key] ?? 0);
            return (
              <g>
                <path class={`trend-line ${colour}`}
                  d={values.map((value, index) => `${index ? "L" : "M"}${x(index).toFixed(1)},${y(value).toFixed(1)}`).join(" ")} />
                {values.map((value, index) => value > 0 && (
                  <circle class={`trend-dot ${colour}`} cx={x(index)} cy={y(value)} r="3" tabindex="0"
                    data-tip={`${model}, ${label(months[index])}: ${value.toLocaleString("en")} ${name.toLowerCase()}`}
                    aria-label={`${model}, ${label(months[index])}: ${value.toLocaleString("en")} ${name.toLowerCase()}`} />
                ))}
              </g>
            );
          })}
          <text class="tick" x={left} y={H - 6}>{label(months[0])}</text>
          <text class="tick" x={W} y={H - 6} text-anchor="end">{label(months.at(-1))}</text>
        </svg>
      </figure>
    ))}
  </div>
</figure>
