---
// The layout main's GitHub Pages site had, as an Astro layout. Its look is
// src/shell.mjs's, shared with pages made outside Astro.
import { address } from "../site.mjs";
import { head, header } from "../shell.mjs";

const SITE_TITLE = "FirmwareLiberator";
// The front page's, in the words people search with. No device models: the
// list of supported devices keeps growing.
const HOME_TITLE = `Sonoff to Tasmota, ESPHome or OpenBeken over Wi-Fi · ${SITE_TITLE}`;
const DESCRIPTION = "Convert Sonoff smart devices from eWeLink to Tasmota, ESPHome or OpenBeken over Wi-Fi: no soldering, no opening the device. Flash it, don't smash it.";
const { title, description = DESCRIPTION, noindex = false } = Astro.props;
const canonical = new URL(address(Astro.url.pathname), Astro.site);
---
<!DOCTYPE html>
<!-- Every page of the site: the rendered Markdown in the shared look
     (src/shell.mjs), dark unless the reader chose light with the button,
     which the browser remembers. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} · ${SITE_TITLE}` : HOME_TITLE}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title || HOME_TITLE}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL("/assets/apple-touch-icon.png", Astro.site)}>
<meta name="twitter:card" content="summary">
<Fragment set:html={head()} />
</head>
<body>
<Fragment set:html={header()} />
<article class="markdown-body">
<slot />
</article>
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "5a8e1dd1554949129f3bcf166588fabd"}'></script>
</body>
</html>
