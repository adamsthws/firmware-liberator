{
  "$comment": "Written by tools/repo/report_schema.py: change that, not this.",
  "maxBytes": 8192,
  "failurePatterns": [
    [
      "declined",
      "^not confirmed|was not confirmed|requires an explicit confirmation"
    ],
    [
      "nothing-to-do",
      "already runs Sonoff's firmware: there is nothing to convert"
    ],
    [
      "crash",
      "^something unexpected went wrong"
    ],
    [
      "no-room",
      "has no room to save"
    ],
    [
      "device-lost",
      "connection to the device was lost"
    ],
    [
      "weak-signal",
      "weak Wi-Fi signal"
    ],
    [
      "unsupported-device",
      "which this tool does not convert yet|not set up as a device this tool converts"
    ],
    [
      "device-busy",
      "still busy with an update"
    ],
    [
      "credentials",
      "encryption key|encryption: line|has a password|password|NeedsPassword"
    ],
    [
      "unsafe-state",
      "refusing to start from an unsafe state|another run is converting this device|has no record of|is not set; pass|address is not known|device id is not known|bundle has changed since|already running our installer|is running Tasmota, not Sonoff's firmware|so the installer has to be sent again"
    ],
    [
      "backup",
      "backup cannot be written back|backup could not be read|no backup of|found neither with a backup|cannot be put back without a backup"
    ],
    [
      "identity",
      "identity cannot be kept"
    ],
    [
      "integrity",
      "checksums failed|does not match the pinned|hash differs|is not the file firmware\\.json pins|refusing to send it|rt_ota"
    ],
    [
      "download",
      "could not be fetched|no public dump of|no \\S+ image is published|image is missing|public dump holds no"
    ],
    [
      "ewelink-unreachable",
      "eWeLink could not be reached"
    ],
    [
      "ewelink-refused",
      "official update file for the .* was refused|firmware was not sent:|readout firmware was not sent"
    ],
    [
      "bad-option",
      "--replace-own-build|needs to be told which firmware|cannot go to |cannot switch to|not sent from a test run|eWeLink account given"
    ],
    [
      "ewelink-account",
      "eWeLink account|eWeLink query failed|did not answer the eWeLink discovery"
    ],
    [
      "computer-network",
      "this computer reaches|this computer's address|are all in use on this computer|--listen-ip|readout could not be sent|did not fetch the \\S+ instructions|without reaching this computer"
    ],
    [
      "network-join",
      "did not join|cannot join it|has not answered on your Wi-Fi|did not answer on your Wi-Fi|neither rejoined|did not come back after its settings were reset|did not say which Wi-Fi network|but the bundle is set up for"
    ],
    [
      "settings-lost",
      "lost its settings|did not keep its template"
    ],
    [
      "unexpected-layout",
      "not laid out as this tool expects|partition table|memory could not be read"
    ],
    [
      "not-taken",
      "did not take|did not hold|still running from slot|keeps going back to the mover|still answers as the firmware it was to leave|has not been seen to run|did not come back after the upload|has not started ESPHome|did not switch to its safeboot|would not take its new name|went back to its Sonoff firmware before|still on its Sonoff firmware, so nothing was read|would not fetch Sonoff's firmware back|refused to fetch Sonoff's firmware|after it was sent \\d+ times"
    ],
    [
      "upload-cut",
      "stopped part way|was not uploaded|to the device failed|could not be sent to the device|did not complete within|did not print|nothing was armed"
    ],
    [
      "unexpected-firmware",
      "did not answer as a device this tool converts|Berry|did not say twice alike|did not say which slot|it is not the one this tool installs|metadata just written|redirected .* too many times"
    ],
    [
      "preparation",
      "cannot be used|could not be prepared|cannot be prepared|could not be set up for"
    ],
    [
      "device-not-found",
      "nothing answers at|could not tell which device"
    ],
    [
      "device-no-answer",
      "did not answer within|did not restart within|did not answer\\b"
    ]
  ],
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "maxLength": 32
    },
    "proof": {
      "type": "string",
      "pattern": "^[0-9]{1,12}:[0-9]{1,20}$",
      "maxLength": 33
    },
    "tag": {
      "type": "string",
      "enum": [
        "user",
        "dev"
      ]
    },
    "tool": {
      "type": "string",
      "pattern": "^2\\.[0-9]{1,3}\\.[0-9]{1,3}$",
      "maxLength": 11
    },
    "kind": {
      "type": "string",
      "enum": [
        "run"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "converted",
        "updated",
        "put-back",
        "failed",
        "crashed"
      ]
    },
    "stopped": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "step": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][0-9]{1,2}$",
          "maxLength": 3
        },
        "error": {
          "type": "string",
          "enum": [
            "device-not-found",
            "device-no-answer",
            "device-lost",
            "device-busy",
            "weak-signal",
            "network-join",
            "computer-network",
            "unsupported-device",
            "unexpected-firmware",
            "unexpected-layout",
            "upload-cut",
            "not-taken",
            "settings-lost",
            "identity",
            "backup",
            "download",
            "integrity",
            "preparation",
            "ewelink-unreachable",
            "ewelink-account",
            "ewelink-refused",
            "credentials",
            "bad-option",
            "unsafe-state",
            "no-room",
            "declined",
            "nothing-to-do",
            "crash",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "^[ -~]*$",
          "maxLength": 200
        }
      },
      "required": [
        "step",
        "error",
        "text"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "espressif",
        "beken",
        null
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sonoff-s60",
        "sonoff-s61",
        "sonoff-pow-elite",
        "sonoff-powct",
        "sonoff-th-elite",
        "sonoff-dualr3",
        "sonoff-basic-1gs",
        "sonoff-nspanel",
        "sonoff-basicr4",
        "sonoff-minir4",
        "sonoff-m5-1c",
        "sonoff-m5-2c",
        "sonoff-m5-3c",
        null
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9][A-Z0-9-]{0,23}$",
      "maxLength": 24
    },
    "stock": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{1,4}(\\.\\d{1,4}){1,3}$",
      "maxLength": 19
    },
    "device_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "firmware": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "tasmota",
        "esphome",
        "sonoff",
        "openbeken",
        null
      ]
    },
    "from": {
      "type": "string",
      "enum": [
        "sonoff",
        "tasmota",
        "esphome",
        "openbeken",
        "midway",
        "committed",
        "installer",
        "interim",
        "safeboot",
        "untemplated",
        "outdated",
        "tasmota-direct"
      ]
    },
    "backup": {
      "type": "string",
      "enum": [
        "saved",
        "existing",
        "failed",
        "not wanted",
        "unreadable",
        "not taken"
      ]
    },
    "identity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "backup",
        "kept",
        "account",
        null
      ]
    },
    "os": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._()+/-]{1,48}$",
          "maxLength": 48
        }
      },
      "required": [
        "family",
        "version"
      ],
      "additionalProperties": false
    },
    "python": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^([0-9]{1,4}(\\.[0-9]{1,4}){1,3}|unknown)$",
          "maxLength": 19
        },
        "source": {
          "type": "string",
          "enum": [
            "portable",
            "start-sh",
            "venv",
            "system",
            "other"
          ]
        }
      },
      "required": [
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "resumed": {
      "type": "boolean"
    },
    "stages": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][0-9]{1,2}$",
        "maxLength": 3
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "busy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "tries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "s",
          "busy",
          "tries"
        ],
        "additionalProperties": false
      }
    },
    "signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -127,
      "maximum": 0
    },
    "wifi_typed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "setup_network": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "power_cycled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "checks": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not-run"
      ]
    },
    "meter": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sonoff",
        "carried",
        "carried-factory",
        "skipped",
        "stock-nvs",
        "from-backup",
        "missing",
        "reported",
        "not-checked",
        null
      ]
    }
  },
  "required": [
    "format",
    "id",
    "proof",
    "tag",
    "tool",
    "kind",
    "result",
    "stopped",
    "family",
    "device",
    "model",
    "stock",
    "device_hash",
    "firmware",
    "from",
    "backup",
    "identity",
    "os",
    "python",
    "seconds",
    "resumed",
    "stages",
    "signal",
    "wifi_typed",
    "setup_network",
    "power_cycled",
    "checks",
    "meter"
  ],
  "additionalProperties": false
}
