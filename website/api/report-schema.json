{
  "$comment": "Written by tools/repo/report_schema.py: change that, not this.",
  "maxBytes": 8192,
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "maxLength": 32
    },
    "proof": {
      "type": "string",
      "pattern": "^[0-9]{1,12}:[0-9]{1,20}$",
      "maxLength": 33
    },
    "tag": {
      "type": "string",
      "enum": [
        "user",
        "dev"
      ]
    },
    "tool": {
      "type": "string",
      "pattern": "^2\\.[0-9]{1,3}\\.[0-9]{1,3}$",
      "maxLength": 11
    },
    "kind": {
      "type": "string",
      "enum": [
        "run"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "converted",
        "updated",
        "put-back",
        "failed",
        "crashed"
      ]
    },
    "stopped": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "step": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][0-9]{1,2}$",
          "maxLength": 3
        },
        "error": {
          "type": "string",
          "enum": [
            "device-not-found",
            "device-no-answer",
            "device-lost",
            "device-busy",
            "weak-signal",
            "network-join",
            "computer-network",
            "unsupported-device",
            "unexpected-firmware",
            "unexpected-layout",
            "upload-cut",
            "not-taken",
            "settings-lost",
            "identity",
            "backup",
            "download",
            "integrity",
            "preparation",
            "ewelink-unreachable",
            "ewelink-account",
            "ewelink-refused",
            "credentials",
            "bad-option",
            "unsafe-state",
            "no-room",
            "declined",
            "nothing-to-do",
            "crash",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "^[ -~]*$",
          "maxLength": 200
        }
      },
      "required": [
        "step",
        "error",
        "text"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "espressif",
        "beken",
        null
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sonoff-s60",
        "sonoff-s61",
        "sonoff-pow-elite",
        "sonoff-powct",
        "sonoff-th-elite",
        "sonoff-dualr3",
        "sonoff-basic-1gs",
        "sonoff-nspanel",
        "sonoff-basicr4",
        "sonoff-minir4",
        "sonoff-m5-1c",
        "sonoff-m5-2c",
        "sonoff-m5-3c",
        null
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9][A-Z0-9-]{0,23}$",
      "maxLength": 24
    },
    "stock": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{1,4}(\\.\\d{1,4}){1,3}$",
      "maxLength": 19
    },
    "plug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "firmware": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "tasmota",
        "esphome",
        "sonoff",
        "openbeken",
        null
      ]
    },
    "from": {
      "type": "string",
      "enum": [
        "sonoff",
        "tasmota",
        "esphome",
        "openbeken",
        "midway",
        "committed",
        "installer",
        "interim",
        "safeboot",
        "untemplated",
        "outdated",
        "tasmota-direct"
      ]
    },
    "backup": {
      "type": "string",
      "enum": [
        "saved",
        "existing",
        "failed",
        "not wanted",
        "unreadable",
        "not taken"
      ]
    },
    "identity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "backup",
        "kept",
        "account",
        null
      ]
    },
    "os": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._()+/-]{1,48}$",
          "maxLength": 48
        }
      },
      "required": [
        "family",
        "version"
      ],
      "additionalProperties": false
    },
    "python": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^([0-9]{1,4}(\\.[0-9]{1,4}){1,3}|unknown)$",
          "maxLength": 19
        },
        "source": {
          "type": "string",
          "enum": [
            "portable",
            "start-sh",
            "venv",
            "system",
            "other"
          ]
        }
      },
      "required": [
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "resumed": {
      "type": "boolean"
    },
    "stages": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][0-9]{1,2}$",
        "maxLength": 3
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "busy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "tries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "s",
          "busy",
          "tries"
        ],
        "additionalProperties": false
      }
    },
    "signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -127,
      "maximum": 0
    },
    "wifi_typed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "setup_network": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "power_cycled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "checks": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not-run"
      ]
    },
    "meter": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sonoff",
        "carried",
        "carried-factory",
        "skipped",
        "stock-nvs",
        "from-backup",
        "missing",
        "reported",
        "not-checked",
        null
      ]
    }
  },
  "required": [
    "format",
    "id",
    "proof",
    "tag",
    "tool",
    "kind",
    "result",
    "stopped",
    "family",
    "device",
    "model",
    "stock",
    "plug",
    "firmware",
    "from",
    "backup",
    "identity",
    "os",
    "python",
    "seconds",
    "resumed",
    "stages",
    "signal",
    "wifi_typed",
    "setup_network",
    "power_cycled",
    "checks",
    "meter"
  ],
  "additionalProperties": false
}
