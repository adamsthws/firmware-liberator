{
  "$comment": "Written by tools/repo/report_schema.py: change that, not this.",
  "maxBytes": 8192,
  "failurePatterns": [
    [
      "declined",
      "^not confirmed|was not confirmed|requires an explicit confirmation|^skipped as asked"
    ],
    [
      "nothing-to-do",
      "already runs Sonoff's firmware: there is nothing to convert"
    ],
    [
      "crash",
      "^something unexpected went wrong"
    ],
    [
      "no-room",
      "has no room to save"
    ],
    [
      "device-lost",
      "connection to the device was lost"
    ],
    [
      "weak-signal",
      "weak Wi-Fi signal"
    ],
    [
      "unsupported-device",
      "which this tool does not convert yet|not set up as a device this tool converts"
    ],
    [
      "device-busy",
      "still busy with an update"
    ],
    [
      "credentials",
      "encryption key|encryption: line|has a password|password|NeedsPassword"
    ],
    [
      "unsafe-state",
      "refusing to start from an unsafe state|another run is converting this device|has no record of|is not set; pass|address is not known|device id is not known|bundle has changed since|already running our installer|is running Tasmota, not Sonoff's firmware|so the installer has to be sent again"
    ],
    [
      "backup",
      "backup cannot be written back|backup could not be read|no backup of|found neither with a backup|cannot be put back without a backup|--simulate-backup-failure"
    ],
    [
      "identity",
      "identity cannot be kept"
    ],
    [
      "integrity",
      "checksums failed|does not match the pinned|hash differs|is not the file firmware\\.json pins|refusing to send it|rt_ota"
    ],
    [
      "download",
      "could not be fetched|no public dump of|no \\S+ image is published|image is missing|public dump holds no|the download was cut off"
    ],
    [
      "ewelink-unreachable",
      "eWeLink could not be reached|has not reached eWeLink"
    ],
    [
      "ewelink-refused",
      "official update file for the .* was refused|firmware was not sent:|readout firmware was not sent"
    ],
    [
      "bad-option",
      "--replace-own-build|needs to be told which firmware|cannot go to |cannot switch to|not sent from a test run|^not from a test run|eWeLink account given"
    ],
    [
      "ewelink-account",
      "eWeLink account|eWeLink query failed"
    ],
    [
      "computer-network",
      "this computer reaches|this computer's address|are all in use on this computer|--listen-ip|readout could not be sent|did not fetch the \\S+ instructions|without reaching this computer|firewall rule|^sudo |the website answered"
    ],
    [
      "network-join",
      "did not join|cannot join it|has not answered on your Wi-Fi|did not answer on your Wi-Fi|neither rejoined|did not come back after its settings were reset|did not say which Wi-Fi network|but the bundle is set up for|has not shown the device online again"
    ],
    [
      "settings-lost",
      "lost its settings|did not keep its template"
    ],
    [
      "unexpected-layout",
      "not laid out as this tool expects|partition table|memory could not be read|short read of the device's flash|bytes were read"
    ],
    [
      "not-taken",
      "did not take|did not hold|still running from slot|keeps going back to the mover|still answers as the firmware it was to leave|has not been seen to run|did not come back after the upload|has not started ESPHome|did not switch to its safeboot|would not take its new name|went back to its Sonoff firmware before|still on its Sonoff firmware, so nothing was read|would not fetch Sonoff's firmware back|refused to fetch Sonoff's firmware|after it was sent \\d+ times"
    ],
    [
      "upload-cut",
      "stopped part way|was not uploaded|to the device failed|could not be sent to the device|did not complete within|did not print|nothing was armed|delivery failed|the device fetched \\S+ of \\S+ bytes"
    ],
    [
      "unexpected-firmware",
      "did not answer as a device this tool converts|Berry|did not say twice alike|did not say which slot|it is not the one this tool installs|metadata just written|redirected .* too many times|official update file for the .* is for "
    ],
    [
      "preparation",
      "cannot be used|could not be prepared|cannot be prepared|could not be set up for"
    ],
    [
      "device-not-found",
      "nothing answers at|could not tell which device"
    ],
    [
      "device-no-answer",
      "did not answer within|did not restart within|did not answer\\b"
    ]
  ],
  "failureClasses": {
    "device-not-found": "nothing answered at the device's address, or which device is there could not be told",
    "device-no-answer": "the device stopped answering within a wait",
    "device-lost": "the connection to the device was reset, cut off or timed out mid-request",
    "device-busy": "the device turned firmware down, busy with an update cut off",
    "weak-signal": "stopped for the device's weak Wi-Fi signal",
    "network-join": "this computer or the device did not join a network in time",
    "computer-network": "this computer's address, ports or firewall kept it from the device",
    "unsupported-device": "a device this tool does not convert yet",
    "unexpected-firmware": "the device answered as firmware other than the run expected",
    "unexpected-layout": "the device's memory or partition table is not as expected",
    "upload-cut": "sending to the device stopped part way, or nothing was sent",
    "not-taken": "an image was sent but did not take, did not hold, or the device went back",
    "settings-lost": "the new firmware runs but lost its settings or template",
    "identity": "the device's Sonoff identity could not be kept",
    "backup": "the Sonoff backup is missing, unreadable or could not be written back",
    "download": "a published image, public dump or official update could not be fetched",
    "integrity": "a file's hash or pin differs, so it was refused",
    "preparation": "what is sent to the device could not be prepared on this computer",
    "ewelink-unreachable": "eWeLink could not be reached",
    "ewelink-account": "the device is not in the account, or the account could not be used",
    "ewelink-refused": "eWeLink did not take the command or the update",
    "credentials": "a password or key was needed or wrong",
    "bad-option": "options that cannot go together, or a firmware the device cannot take",
    "unsafe-state": "a safety lock, or the run's record of the device, was not as needed",
    "no-room": "this computer had no room to save what the run needs",
    "declined": "the person said no at a confirmation",
    "nothing-to-do": "the device already runs what was asked",
    "crash": "an error the tool did not anticipate",
    "other": "not classed yet"
  },
  "stoppedBy": [
    "quit",
    "ctrl-c",
    "window-closed"
  ],
