# Answers given in advance, for a conversion nobody sits through:
#
#     python3 tools/repo/unattended_run.py      recorded, the final screen shown at the end
#     sh start.sh run --unattended          the same, unrecorded
#
# Copy this file to .env (which git ignores), fill it in, and keep it to
# yourself:  chmod 600 .env
# Names set in the environment win over the file.

# The eWeLink account the device is in: its email, or the phone number it was
# made with, with its country code (+44 7700 900123).
EWELINK_EMAIL=
EWELINK_PASSWORD=

# Linux and macOS: this computer's password, only where sudo asks for one -
# the run adds, then removes, a firewall rule letting the device fetch firmware
# from this computer. Leave it empty if sudo does not ask. (Windows asks in
# its own UAC window instead, which still needs a click.)
AUTOFLASH_SUDO_PASSWORD=

# Only for converting a device from an ESPHome that cannot say its Wi-Fi
# password (one older than this project's 1.1.0, or whose API has an
# encryption key not given below) when this computer has no Sonoff backup of
# the device to take it from: the 2.4 GHz network it is on, and its password
# (leave the password out for an open network). From any other firmware the
# run reads them off the device itself.
AUTOFLASH_WIFI_SSID=
AUTOFLASH_WIFI_PASSWORD=

# Only for a device with a password on its firmware: Tasmota's web password
# (its user is admin); ESPHome's update password (the password: line under
# ota: in the device's ESPHome YAML config); or ESPHome's web login (username:
# and password: under web_server: auth: there). Without it a run asks for it,
# or, unattended, stops there.
AUTOFLASH_TASMOTA_PASSWORD=
AUTOFLASH_ESPHOME_OTA_PASSWORD=
AUTOFLASH_ESPHOME_WEB_USER=
AUTOFLASH_ESPHOME_WEB_PASSWORD=

# Only for a device on ESPHome with an API encryption key (the key: line under
# api: encryption: in its ESPHome YAML config, as it is there): with it the
# run reads the device's Wi-Fi details off it, and sends its update encrypted -
# which an ESPHome with encryption: under ota: needs, and for which ESPHome
# asks no update password.
AUTOFLASH_ESPHOME_API_KEY=

# Each run sends an anonymous report of how it went to the project
# (docs/what-the-tool-sends.md says what it holds): 1 here sends none, as
# --no-report does for one run.
AUTOFLASH_NO_REPORT=

# Maintainers only: dev marks a run's report as your own testing, left out of
# the public figures (tools/repo/unattended_run.py sets it for its runs).
AUTOFLASH_REPORT_TAG=

# Maintainers only, never for a run: the key that opens the sealed Sonoff
# backup in the project's private package (.github/private-firmware-backup.md). Made by
# `python3 tools/repo/private_backup.py key`, never typed.
AUTOFLASH_BACKUP_KEY=
