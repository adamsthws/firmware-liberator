{
 "about": "From Sonoff's firmware to ESPHome, the Wi-Fi typed (--wifi), its password mistyped once; sudo remembering nothing, so this computer's password is asked again at the end",
 "start": "fresh",
 "prep": [
  "sudo forgets"
 ],
 "args": [
  "--wifi"
 ],
 "answers": [
  {
   "when": "Press any key",
   "type": "x"
  },
  {
   "when": "Which firmware should the device have",
   "type": "2\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": false
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "Wi-Fi network name",
   "type": "PICSimLabWifi\r"
  },
  {
   "when": "Wi-Fi password",
   "type": "abc\r"
  },
  {
   "when": "Same password again",
   "type": "abd\r"
  },
  {
   "when": "Wi-Fi password",
   "type": "\r"
  },
  {
   "when": "Same password again",
   "type": "\r"
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
