{
 "about": "A readout of a device on Sonoff's firmware in a window 24 rows tall: asked to be made taller, as a conversion is, gone on with a key, and read out all the same, its stages and report drawn as they should be",
 "covers": [
  "from-sonoff",
  "accepted",
  "short-window"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 40,
 "size": "100x24",
 "answers": [
  {
   "when": "Or press any key to go on as it is",
   "type": "x"
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Readout complete!$"
  ]
 }
}
