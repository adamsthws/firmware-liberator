{
 "about": "From Sonoff's firmware to Tasmota: this computer's password and PROCEED each answered wrongly first",
 "start": "fresh",
 "answers": [
  {
   "when": "Press any key",
   "type": "x"
  },
  {
   "when": "Which firmware would you like",
   "type": "1\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "wrong-password-1\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "y\r"
  },
  {
   "when": "Only the TYPED word",
   "type": "PROCEED\r"
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 2,
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
