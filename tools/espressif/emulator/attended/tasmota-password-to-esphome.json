{
 "about": "From a Tasmota with a web password to ESPHome: the password typed wrongly first",
 "covers": [
  "from-converted",
  "device-password",
  "answer-retyped"
 ],
 "start": "stub-suite-tasmota",
 "prep": [
  [
   "tasmota password",
   "test-web-1"
  ]
 ],
 "answers": [
  {
   "when": "What now",
   "type": "1\r",
   "times": 2
  },
  {
   "when": "Tasmota web password",
   "type": "wrong-web-1\r"
  },
  {
   "when": "Tasmota web password",
   "type": "test-web-1\r",
   "shows": [
    "^ *! That is not its web password\\.$"
   ]
  },
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Which firmware should the device have",
   "type": "2\r",
   "never": [
    "^ *-- You'll need:$"
   ]
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "What next",
   "type": "q\r"
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
