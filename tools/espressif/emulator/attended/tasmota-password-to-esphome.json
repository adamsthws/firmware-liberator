{
 "about": "From a Tasmota with a web password to ESPHome: the password typed wrongly first",
 "start": "stub-suite-tasmota",
 "prep": [
  [
   "tasmota password",
   "test-web-1"
  ]
 ],
 "answers": [
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "What now",
   "type": "1\r",
   "times": 2
  },
  {
   "when": "Tasmota web password",
   "type": "wrong-web-1\r"
  },
  {
   "when": "Tasmota web password",
   "type": "test-web-1\r"
  },
  {
   "when": "Press any key",
   "type": "x"
  },
  {
   "when": "Which firmware should the device have",
   "type": "2\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
