   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x"
  },
  {
   "when": "Which firmware should the device have",
   "type": "2\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Updated"
 }
}
