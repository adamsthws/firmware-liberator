   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~1\r"
  },
  {
   "when": "Stage +5 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Stage +9 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f\r",
   "anywhere": true
  },
  {
   "when": "Stage +15 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Generating your report",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~PROCEED\r",
   "times": 3
  },
  {
   "when": "What next",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~q\r"
  },
  {
   "when": "Which device is this run for",
