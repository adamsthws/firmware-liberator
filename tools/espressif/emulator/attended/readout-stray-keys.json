{
 "about": "A readout of a device on Sonoff's firmware in a window 80 wide, keys pressed by accident throughout - letters, the arrows, function keys, Enter - as stages run and before each answer, and the go-ahead answered wrongly first: none shows, moves the cursor or answers a question",
 "covers": [
  "from-sonoff",
  "narrow-window",
  "stray-keys",
  "answer-retyped",
  "accepted"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 40,
 "size": "80x40",
 "answers": [
  {
   "when": "Stage +3 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Stage +5 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~y\r"
  },
  {
   "when": "Only the TYPED word",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~PROCEED\r"
  },
  {
   "when": "What next",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~q\r"
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Readout complete!$"
  ],
  "never": [
   "zq",
   "\\^\\["
  ]
 }
}
