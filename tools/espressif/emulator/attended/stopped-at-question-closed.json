{
 "about": "The window closed (SIGHUP) as the firmware question waits, its notes above it: the run stops, the question and its notes taken off, nothing left under the stage's line",
 "covers": [
  "stopped-at-question-closed"
 ],
 "start": "stub-suite-tasmota",
 "minutes": 15,
 "answers": [
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Which firmware should the device have",
   "signal": "HUP",
   "never": [
    "^ *-- You'll need:$"
   ]
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 130
 }
}
