{
 "about": "Ctrl-C part way through leaving Tasmota for ESPHome, then Enter at the countdown: the run carries on",
 "covers": [
  "from-converted",
  "ctrl-c-carried-on"
 ],
 "start": "stub-suite-tasmota",
 "answers": [
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Which firmware should the device have",
   "type": "2\r",
   "never": [
    "^ *-- You'll need:$"
   ]
  },
  {
   "when": "Stage +\\d+ - Leaving Tasmota +- Underway",
   "type": "\u0003",
   "anywhere": true
  },
  {
   "when": "press Enter now",
   "type": "\r"
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "What next",
   "type": "q\r"
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
