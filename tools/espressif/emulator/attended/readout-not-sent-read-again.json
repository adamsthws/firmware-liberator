{
 "about": "A readout that cannot be sent, nothing answering where it goes, then read out again from What next: the same device, not asked which, and kept again",
 "covers": [
  "from-sonoff",
  "not-sent",
  "failed-then-tried-again"
 ],
 "start": "fresh",
 "command": "readout",
 "api_down": true,
 "minutes": 40,
 "answers": [
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "What next",
   "type": "1\r"
  },
  {
   "when": "What next",
   "type": "q\r"
  }
 ],
 "expect": {
  "exit": 1,
  "shows": [
   "^ *The readout could not be sent: ",
   "^ *Failed: +S60\\S* "
  ]
 }
}
