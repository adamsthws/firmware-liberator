{
 "about": "A readout of every device in an account holding a device on Sonoff's firmware and two made-up devices the stub lists beside it (stub_cloud.accounts' mixed): each read out in turn under a line of its own, the others' first stages alone, all in one report",
 "covers": [
  "from-sonoff",
  "accepted",
  "every-device"
 ],
 "start": "fresh",
 "command": "readout",
 "account": "mixed",
 "args": [
  "--all"
 ],
 "minutes": 60,
 "answers": [
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Readout complete!$",
   "Devices: +3$"
  ]
 }
}
