{
 "about": "From Sonoff's firmware to Tasmota in a window 80 wide, the installer refusing the Tasmota sent to it (simulated): the run fails, its report then the way to open an issue, the report on the clipboard",
 "start": "fresh",
 "size": "80x40",
 "minutes": 40,
 "args": [
  "--simulate-bad-image",
  "D1"
 ],
 "answers": [
  {
   "when": "Press any key",
   "type": "x"
  },
  {
   "when": "Which firmware should the device have",
   "type": "1\r"
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 1,
  "result": "Stopped at stage",
  "shows": [
   "^ *FAILED: the bridge refused the image",
   "^ *If it should not have stopped, please open an issue here:$",
   "^ *This report is on your clipboard\\.$",
   "^ *This run's log:$"
  ],
  "never": [
   "[^.]\\.\\.([^.]|$)"
  ]
 }
}
