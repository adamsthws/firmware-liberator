{
 "about": "Told the device is still on Sonoff's firmware when it runs Tasmota: not found, so its address typed - not an address, then one nothing answers at, then one that is not the device - then quit",
 "covers": [
  "address-typed",
  "answer-retyped"
 ],
 "start": "stub-suite-tasmota",
 "minutes": 20,
 "answers": [
  {
   "when": "Which device is this run for",
   "type": "2\r"
  },
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r"
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "What now",
   "type": "3\r"
  },
  {
   "when": "The device's address",
   "type": "eth0\r"
  },
  {
   "when": "The device's address",
   "type": "192.168.60.99\r",
   "shows": [
    "^ *! 'eth0' is not an address"
   ]
  },
  {
   "when": "The device's address",
   "type": "192.168.60.1\r",
   "shows": [
    "^ *! Nothing answered at 192\\.168\\.60\\.99"
   ]
  },
  {
   "when": "The device's address",
   "type": "q\r",
   "shows": [
    "^ *! 192\\.168\\.60\\.1 answered, but its hardware address could not be read"
   ]
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  }
 ],
 "expect": {
  "exit": 130,
  "screen": false
 }
}
