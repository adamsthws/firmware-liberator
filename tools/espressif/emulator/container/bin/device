#!/bin/bash
# The emulated device's power and serial port.
#   device status          on or off, network, address
#   device log             follow its serial output (secrets masked)
#   device restart         switch off and on again (a power cut)
#   device off | device on   switch it off / on
#   device cycle N [SECS]  N quick power cycles, SECS (default 2) on each time -
#                        Tasmota's settings reset is 7 in a row
#   device router off [SECS]  the access points go, as when the router restarts;
#                        back after SECS if given
#   device router on       the Wi-Fi is back, and the device rejoins by itself
set -euo pipefail
RUN=/run/autoflash-emu
LOG=/state/logs/uart.log

kill_qemu() {
    touch "$RUN/power-cut"   # tells the supervisor this was not the device restarting itself
    [ -f "$RUN/qemu.pid" ] && kill "$(cat "$RUN/qemu.pid")" 2>/dev/null || true
}

current_pid() { cat "$RUN/qemu.pid" 2>/dev/null || true; }

# The fork's access points, on or off, for a QEMU running now; device-supervisor
# starts the next one as $RUN/router-off says. Read back, so that an outage that
# never happened cannot pass for one the device survived.
access_points() {
    local off=on want=true pid answer; [ "$1" = on ] && { off=off; want=false; }
    pid=$(current_pid)
    kill -0 "$pid" 2>/dev/null || return 0
    answer=$(printf 'qom-set wifi access-points-off %s\nqom-get wifi access-points-off\n' "$off" \
        | timeout 10 socat -t2 - "UNIX-CONNECT:$RUN/monitor.sock" 2>/dev/null | tr -d '\r' || true)
    grep -qx "$want" <<<"$answer" && return 0
    [ "$(current_pid)" != "$pid" ] && return 0   # restarted meanwhile: the next one starts right
    echo "QEMU did not take the switch: access-points-off is not $want" >&2
    return 1
}

# Wait until a QEMU other than $1 (if given) is running.
wait_running() {
    for _ in $(seq 100); do
        pid=$(current_pid)
        [ -n "$pid" ] && [ "$pid" != "${1:-}" ] && kill -0 "$pid" 2>/dev/null && return 0
        sleep 0.1
    done
    echo "the device did not start - see: device log" >&2
    return 1
}

case "${1:-status}" in
status)
    if [ -f "$RUN/qemu.pid" ] && kill -0 "$(cat "$RUN/qemu.pid")" 2>/dev/null; then state=on; else state=off; fi
    echo "Power:    $state"
    softap=$(cat "$RUN/softap" 2>/dev/null || true)
    echo "Its own network: ${softap:-(none)}"
    lease=$(awk '{print $3}' "$RUN/leases" 2>/dev/null | head -1)
    echo "Address on the home network: ${lease:-(none yet)}"
    [ -e "$RUN/router-off" ] && echo "Router:   off - the device's Wi-Fi is down (device router on)"
    ;;
log)
    touch "$LOG"
    exec tail -n 200 -F "$LOG"
    ;;
off)
    echo off > "$RUN/power"
    kill_qemu
    echo "Device switched off."
    ;;
on)
    echo on > "$RUN/power"
    wait_running
    echo "Device switched on."
    ;;
restart)
    echo on > "$RUN/power"
    kill_qemu
    echo "Device power-cycled."
    ;;
cycle)
    n=${2:?usage: device cycle N [SECS]}
    secs=${3:-2}
    echo on > "$RUN/power"
    for i in $(seq "$n"); do
        old=$(current_pid)
        kill_qemu
        wait_running "$old"
        echo "  cycle $i/$n: on for ${secs}s"
        sleep "$secs"
    done
    echo "Done; the device stays on."
    ;;
router)
    case "${2:-}" in
    off)
        touch "$RUN/router-off"
        access_points off
        if [ -n "${3:-}" ]; then
            (sleep "$3"; rm -f "$RUN/router-off"; access_points on) >/dev/null 2>&1 &
            echo "Router off: the device's Wi-Fi is down for ${3}s."
        else
            echo "Router off: the device's Wi-Fi is down until: device router on"
        fi
        ;;
    on)
        rm -f "$RUN/router-off"
        access_points on
        echo "Router on: the device rejoins by itself."
        ;;
    *) echo "usage: device router off [SECS] | device router on" >&2; exit 2 ;;
    esac
    ;;
*)
    sed -n '2,/^set /s/^# \{0,1\}//p' "$0"
    exit 2
    ;;
esac
