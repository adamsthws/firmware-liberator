#!/bin/bash
# Root half of `wifi`: puts this "computer" on one network or the other.
#   wifi-root home         the emulated home Wi-Fi: this computer is its router (DHCP, DNS)
#   wifi-root join SSID    the device's own network: this computer is a client of
#                          the device there, while the home network's router stays
#                          up - the device may be trying Wi-Fi details on it
#   wifi-root readdress ADDRESS
#                          the router forgets the device's address and gives it
#                          ADDRESS when it next asks, as a home router may (the
#                          fault suite's readdress); .50 until then
set -euo pipefail
RUN=${AUTOFLASH_EMU_RUN:-/run/autoflash-emu}   # another for its tests, as `wifi` takes
. "$RUN/env"
HOME_SSID=PICSimLabWifi
NET=192.168.60
# The device's address on the home network: .50, unless readdress gave it another.
DEVICE_IP=$(cat "$RUN/device-ip" 2>/dev/null || echo "$NET.50")
JOINED=devicenet   # this computer's interface on the device's network

# This computer's own traffic (the tool and its servers run as the user who
# started the emulator); the router's, dnsmasq's, is root's.
user=$(stat -c %u "$RUN/env")

router_up() {
    [ -f "$RUN/dnsmasq.pid" ] && kill -0 "$(cat "$RUN/dnsmasq.pid")" 2>/dev/null
}

leave_device_network() {
    pkill -f "udhcpc -i $JOINED" 2>/dev/null || true
    ip link del "$JOINED" 2>/dev/null || true
    while iptables -D OUTPUT -o "$LAN" -m owner --uid-owner "$user" -j DROP 2>/dev/null; do :; done
    while iptables -D OUTPUT -o eth0 -m owner --uid-owner "$user" -j DROP 2>/dev/null; do :; done
}

# The router's DHCP and DNS (dnsmasq), the device given DEVICE_IP.
start_router() {
    if [ "$CLOUD" = 1 ]; then dns=(--resolv-file=/etc/resolv.conf); else dns=(--no-resolv); fi
    dnsmasq --interface="$LAN" --bind-interfaces --except-interface=lo \
        --dhcp-range="$NET.100,$NET.199,255.255.255.0,1h" \
        --dhcp-host="$DEVICE_MAC,$DEVICE_IP" \
        --dhcp-option=option:router,"$NET.1" --dhcp-option=option:dns-server,"$NET.1" \
        --dhcp-leasefile="$RUN/leases" --pid-file="$RUN/dnsmasq.pid" \
        --log-dhcp --log-facility="$RUN/dnsmasq.log" "${dns[@]}"
}

# tap0's own MAC, from a join of an earlier version that took tap0 over
[ -f "$RUN/tap-mac" ] || cat /sys/class/net/tap0/address > "$RUN/tap-mac"

case "${1:-}" in
home)
    leave_device_network
    ip route replace 224.0.0.0/4 dev "$LAN"   # mDNS discovery goes to the device's network
    if ! router_up; then
        [ "$(cat /sys/class/net/tap0/address)" = "$(cat "$RUN/tap-mac")" ] || {
            ip link set tap0 down; ip link set tap0 address "$(cat "$RUN/tap-mac")"; ip link set tap0 up; }
        ip address flush dev "$LAN"
        ip address add "$NET.1/24" dev "$LAN"
        start_router
    fi
    echo "$HOME_SSID" > "$RUN/network"
    echo "$DEVICE_IP:80" > "$RUN/browser-target"
    ;;
readdress)
    address=${2:?which address}
    case "$address" in "$NET".[1-9]|"$NET".[1-9][0-9]) ;;
        *) echo "readdress: an address from $NET.1 to $NET.99, not $address" >&2; exit 2 ;; esac
    echo "$address" > "$RUN/device-ip"
    DEVICE_IP=$address
    # Its DHCP alone started again: the router keeps its own address, as a
    # home router forgetting a lease does - taken off for a moment, as home
    # does, it cut off what the tool serves the device (seen: D5's plan never
    # fetched).
    if router_up; then kill "$(cat "$RUN/dnsmasq.pid")"; sleep 1; fi
    # Its pid forgotten too: nothing in the container reaps it, and its
    # zombie answers kill -0 (router_up).
    rm -f "$RUN/dnsmasq.pid"
    : > "$RUN/leases"
    start_router
    echo "$address:80" > "$RUN/browser-target"
    # The ARP filter (entrypoint.sh) lets requests for the device's own address
    # alone reach its emulated Wi-Fi: the new one now.
    tc filter del dev tap0 egress pref 1 2>/dev/null || true
    tc filter add dev tap0 egress pref 1 protocol arp flower arp_op request arp_tip "$address" action pass
    ;;
join)
    ssid=${2:?which network}
    if [ "$WINDOWS" = 1 ]; then
        echo "Windows is the computer on this network (emu.sh --windows), and joining" >&2
        echo "the device's own network from Windows is not emulated." >&2
        exit 1
    fi
    leave_device_network
    # The fork's station on the device's network (lcgamboa/qemu #15) joins it by
    # itself once it is on air, within a second or two, and has a MAC of its own,
    # which this side takes; udhcpc, below, asks until it has.
    for _ in $(seq 40); do
        [ -n "$(cat "$RUN/softap" 2>/dev/null)" ] && break
        sleep 0.5
    done
    if [ -z "$(cat "$RUN/softap" 2>/dev/null)" ]; then
        echo "the emulated Wi-Fi did not join $ssid" >&2
        exit 1
    fi
    ip link add "$JOINED" link "$LAN" address 02:53:36:30:00:02 type macvlan mode bridge
    ip link set "$JOINED" up
    # Off the home network while joined, as a laptop is: its traffic there and
    # to the internet stops; the router's (root's) goes on.
    iptables -I OUTPUT 1 -o "$LAN" -m owner --uid-owner "$user" -j DROP
    iptables -I OUTPUT 1 -o eth0 -m owner --uid-owner "$user" -j DROP
    ip route replace 224.0.0.0/4 dev "$JOINED"
    echo "$ssid" > "$RUN/network"
    if udhcpc -i "$JOINED" -q -n -t 8 -T 2 -s /opt/autoflash-emu/udhcpc.script >"$RUN/udhcpc.log" 2>&1; then
        echo "$(cat "$RUN/gateway"):80" > "$RUN/browser-target"
    else
        echo "no address from $ssid" >&2
        exit 1
    fi
    ;;
*)
    echo "usage: wifi-root home | join SSID | readdress ADDRESS" >&2
    exit 2
    ;;
esac
chown -R "$(stat -c %u "$RUN/env"):$(stat -c %g "$RUN/env")" "$RUN" 2>/dev/null || true
