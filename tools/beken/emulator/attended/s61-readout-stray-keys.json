{
 "about": "A readout of an S61 on Sonoff's firmware in a window 80 wide, keys pressed by accident throughout - letters, the arrows, function keys, Enter - as stages run and before each answer, and the go-ahead answered wrongly first: none shows, moves the cursor or answers a question",
 "covers": [
  "from-sonoff",
  "narrow-window",
  "stray-keys",
  "answer-retyped",
  "accepted"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "size": "80x40",
 "answers": [
  {
   "when": "Stage +3 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Stage +5 - .* +- Underway",
   "type": "zq\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~\u007f",
   "anywhere": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~y\r"
  },
  {
   "when": "Only the TYPED word",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~PROCEED\r"
  },
  {
   "when": "What next",
   "type": "\u001b[A\u001b[B\u001b[C\u001b[D\u001b[H\u001b[F\u001bOP\t\u001b[5~q\r"
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Readout complete!$"
  ],
  "never": [
   "zq",
   "\\^\\["
  ]
 }
}
