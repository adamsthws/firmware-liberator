{
 "about": "An S61 from Sonoff's firmware to OpenBeken, the eWeLink sign-in typed",
 "covers": [
  "from-sonoff"
 ],
 "start": "fresh",
 "minutes": 60,
 "answers": [
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 2,
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "Which firmware should the device have",
   "type": "1\r",
   "never": [
    "^ *-- You'll need:$"
   ]
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "What next",
   "type": "q\r"
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
