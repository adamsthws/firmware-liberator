{
 "about": "An S61 from Sonoff's firmware to ESPHome in a window 80 wide, its bootloader refusing the ESPHome image (simulated) each time it is sent, the device restarted between: the run fails, its report then the way to open an issue, the report on the clipboard",
 "start": "fresh",
 "size": "80x40",
 "minutes": 60,
 "args": [
  "--simulate-bad-image",
  "J2:9"
 ],
 "answers": [
  {
   "when": "Press any key",
   "type": "x",
   "times": 3
  },
  {
   "when": "Which firmware would you like",
   "type": "2\r"
  },
  {
   "when": "What now",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 1,
  "result": "Stopped at stage",
  "shows": [
   "^ *FAILED: ESPHome was not installed",
   "^ *If it should not have stopped, please open an issue here:$",
   "^ *This report is on your clipboard, ready to paste\\.$",
   "^ *This run's log:$"
  ]
 }
}
