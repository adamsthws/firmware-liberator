{
 "about": "A readout of an S61 on Sonoff's firmware that cannot be sent, nothing answering where it goes: kept, to send later",
 "covers": [
  "from-sonoff",
  "not-sent"
 ],
 "start": "fresh",
 "command": "readout",
 "api_down": true,
 "minutes": 60,
 "answers": [
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 2,
   "optional": true
  }
 ],
 "expect": {
  "exit": 1,
  "shows": [
   "^ *The readout could not be sent: ",
   "^ *Failed: +S61\\S* "
  ]
 }
}
