{
 "about": "Ctrl-C as a readout probes the device, then Enter at the countdown its next question shows: the readout carries on to the end",
 "covers": [
  "from-sonoff",
  "accepted",
  "ctrl-c-carried-on"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "answers": [
  {
   "when": "Stage +3 - .* +- Underway",
   "type": "\u0003",
   "anywhere": true
  },
  {
   "when": "press Enter now",
   "type": "\r"
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Readout complete!$"
  ]
 }
}
