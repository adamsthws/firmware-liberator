{
 "about": "An S61 from Sonoff's firmware to OpenBeken, the device switched off as OpenBeken is checked and on again half a minute later: it carries on to the end",
 "covers": [
  "from-sonoff",
  "device-switched-off"
 ],
 "start": "fresh",
 "minutes": 60,
 "answers": [
  {
   "when": "Which firmware should the device have",
   "type": "1\r"
  },
  {
   "when": "Stage +6 - Checking OpenBeken +- Underway",
   "power": "off",
   "anywhere": true
  },
  {
   "when": "Stage +6 - Checking OpenBeken +- Underway",
   "power": "on",
   "anywhere": true,
   "after": 30
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
