{
 "about": "Told the device is still on Sonoff's firmware when it runs OpenBeken: not found, so its address typed - not an address, then one nothing answers at - then quit",
 "covers": [
  "address-typed",
  "answer-retyped"
 ],
 "start": "openbeken",
 "minutes": 60,
 "answers": [
  {
   "when": "Which device is this run for",
   "type": "2\r"
  },
  {
   "when": "What now",
   "type": "3\r"
  },
  {
   "when": "The device's address",
   "type": "eth0\r"
  },
  {
   "when": "The device's address",
   "type": "192.0.2.99\r"
  },
  {
   "when": "The device's address",
   "type": "q\r"
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 130,
  "screen": false
 }
}
