{
 "about": "A readout of an S61 still on Sonoff's firmware, q typed at its go-ahead: stopped as asked, not failed, nothing sent to it",
 "covers": [
  "from-sonoff",
  "declined-at-go-ahead"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 40,
 "answers": [
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "Type .+ to go ahead",
   "type": "q\r"
  }
 ],
 "expect": {
  "exit": 130,
  "shows": [
   "^ *Stopped as asked\\."
  ],
  "never": [
   "FAILED"
  ]
 }
}
