{
 "about": "The window closed (SIGHUP) as a readout's go-ahead waits: the question taken off, the stage stopped",
 "covers": [
  "stopped-at-question-closed"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "answers": [
  {
   "when": "Type .+ to go ahead",
   "signal": "HUP"
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 130
 }
}
