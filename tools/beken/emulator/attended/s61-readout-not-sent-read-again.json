{
 "about": "A readout of an S61 that cannot be sent, nothing answering where it goes, then read out again from What next: the same device, not asked which, and kept again",
 "covers": [
  "from-sonoff",
  "not-sent",
  "failed-then-tried-again"
 ],
 "start": "fresh",
 "command": "readout",
 "api_down": true,
 "minutes": 60,
 "answers": [
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "What next",
   "type": "1\r"
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 1,
  "shows": [
   "^ *The readout could not be sent: ",
   "^ *Failed: +S61\\S* "
  ]
 }
}
