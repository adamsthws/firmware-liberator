{
 "about": "An S61 from Sonoff's firmware to OpenBeken, Ctrl-C as the new firmware is sent, then Enter at the countdown: the run carries on",
 "covers": [
  "from-sonoff",
  "ctrl-c-carried-on"
 ],
 "start": "fresh",
 "answers": [
  {
   "when": "Press any key",
   "type": "x",
   "shows": [
    "^ *-- You'll need:$",
    "^ *- Keep the device powered and this computer on \\(don't interrupt it\\)\\.$"
   ]
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 2,
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r"
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r"
  },
  {
   "when": "Which firmware should the device have",
   "type": "1\r",
   "never": [
    "^ *-- You'll need:$"
   ]
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3
  },
  {
   "when": "Stage +\\d+ - Sending the new firmware +- Underway",
   "type": "\u0003",
   "anywhere": true
  },
  {
   "when": "press Enter now",
   "type": "\r"
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "result": "Converted"
 }
}
