{
 "about": "A readout of an S61 still on Sonoff's firmware, the eWeLink sign-in typed",
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "answers": [
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": false
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": false
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 2,
   "optional": true
  },
  {
   "when": "Add a way to reach you",
   "type": "2\r"
  },
  {
   "when": "Your email address",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0
 }
}
