{
 "about": "A readout of an S61 on Sonoff's firmware, the device switched off as its memory is read: the read fails, the run says to switch it off and on, and it is; then the readout run again, as a person would, reads it whole",
 "covers": [
  "from-sonoff",
  "device-switched-off"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "answers": [
  {
   "when": "Stage +5 - .* +- Underway",
   "power": "off",
   "anywhere": true,
   "after": 20
  },
  {
   "when": "switch it off and on, wait until|still on the readout firmware: switch it off",
   "power": "on",
   "anywhere": true
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "What next",
   "type": "q\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 1,
  "shows": [
   "^ *FAILED: "
  ]
 },
 "again": {
  "minutes": 60,
  "answers": [
   {
    "when": "Which device should be read out",
    "type": "1\r",
    "optional": true
   },
   {
    "when": "Press any key",
    "type": "x",
    "times": 3,
    "optional": true
   },
   {
    "when": "Which device is this run for",
    "type": "1\r",
    "optional": true
   },
   {
    "when": "This computer's password \\(for sudo\\)",
    "type": "autoflash\r",
    "times": 6,
    "optional": true
   },
   {
    "when": "Type .+ to go ahead",
    "type": "PROCEED\r",
    "times": 3,
    "optional": true
   },
   {
    "when": "Which eWeLink account is this device in",
    "type": "2\r",
    "optional": true
   },
   {
    "when": "eWeLink account email or phone number",
    "type": "someone@example.invalid\r",
    "optional": true
   },
   {
    "when": "eWeLink password for",
    "type": "made-up-password\r",
    "optional": true
   },
   {
    "when": "What next",
    "type": "q\r",
    "optional": true
   },
   {
    "when": "\\[[Yy]/n\\]",
    "type": "n\r",
    "optional": true
   },
   {
    "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
    "type": "y\r",
    "times": 3,
    "optional": true
   }
  ],
  "expect": {
   "exit": 0,
   "shows": [
    "^ *Readout complete!$"
   ]
  }
 }
}
