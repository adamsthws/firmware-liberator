{
 "about": "A readout of an S61 on Sonoff's firmware, accepted, then \"What next\": another read out, the same device, which the website then has: not needed, both in the report",
 "covers": [
  "from-sonoff",
  "accepted",
  "what-next-another"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 120,
 "answers": [
  {
   "when": "What next",
   "type": "2\r"
  },
  {
   "when": "What next",
   "type": "q\r"
  },
  {
   "when": "Which device should be read out",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "Press any key",
   "type": "x",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which device is this run for",
   "type": "1\r",
   "optional": true
  },
  {
   "when": "This computer's password \\(for sudo\\)",
   "type": "autoflash\r",
   "times": 6,
   "optional": true
  },
  {
   "when": "Type .+ to go ahead",
   "type": "PROCEED\r",
   "times": 3,
   "optional": true
  },
  {
   "when": "Which eWeLink account is this device in",
   "type": "2\r",
   "optional": true
  },
  {
   "when": "eWeLink account email or phone number",
   "type": "someone@example.invalid\r",
   "optional": true
  },
  {
   "when": "eWeLink password for",
   "type": "made-up-password\r",
   "optional": true
  },
  {
   "when": "\\[[Yy]/n\\]",
   "type": "n\r",
   "optional": true
  },
  {
   "when": "\\(y/N[^)]*\\)|\\(Y/n[^)]*\\)",
   "type": "y\r",
   "times": 3,
   "optional": true
  }
 ],
 "expect": {
  "exit": 0,
  "shows": [
   "^ *Nothing was read out\\.$",
   "Not needed: +1$"
  ]
 }
}
