{
 "about": "Ctrl-C typed as a readout's go-ahead waits: the question taken off, the stage stopped",
 "covers": [
  "stopped-at-question-ctrl-c"
 ],
 "start": "fresh",
 "command": "readout",
 "minutes": 60,
 "answers": [
  {
   "when": "Type .+ to go ahead",
   "type": "\u0003"
  }
 ],
 "expect": {
  "exit": 130,
  "shows": [
   "Stopped with Ctrl-C"
  ]
 }
}
