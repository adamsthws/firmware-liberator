@@ -403,6 +431,13 @@ class WifiPeer:
         self._send(self._mgmt(MGMT_PROBE_REQ, BCAST, self.mac, BCAST, body))
 
     def _sta_tick(self, now):
+        if self.bss is not None and now - self.bss.get("seen_us", now) > BEACON_LOSS_US:
+            self.log("[WIFI] lost BSS '%s': no beacon for %d s" % (self.bss["ssid"], BEACON_LOSS_US // 1_000_000))
+            self.bss = None
+            self.sta_state = "SCAN"
+            self.aid = 0
+            if self.net is not None:
+                self.net.device_reset(now)
         if self.bss is None:
             if now >= self.sta_next_us:
                 self._sta_probe()
@@ -598,7 +633,7 @@ class WifiPeer:
             if a2 not in self.stations or self.stations[a2]["state"] != "ASSOC":
