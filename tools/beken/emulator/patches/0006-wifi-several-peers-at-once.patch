-            if not from_ds:
+            if not from_ds or self.bss is None or a2 != self.bss["bssid"]:
                 return
             da, sa = a1, a3
             if da != self.mac and not (da[0] & 1):
@@ -624,6 +659,10 @@ class WifiPeer:
     # ------------------------------------------------------------------ tick
     def tick(self, insns=None):
         now = self.now_us()
+        if not self.on_air:
+            if self.net is not None:
+                self.net.tick(now)   # what the network sends is lost (send_eth)
+            return
         self._release(now)
         if self.active_role == "sta":
             self._sta_tick(now)
diff --git a/tests/wifi_peers.py b/tests/wifi_peers.py
new file mode 100644
index 0000000..bb3b249
--- /dev/null
+++ b/tests/wifi_peers.py
@@ -0,0 +1,139 @@
+"""Several Wi-Fi peers on the air at once: the access point a device joins,
+and a station joining the device's own network, each taking only what is
+addressed to it."""
+
+import struct
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from src.emulator import BekenEmulator
+from src import wifipeer
+from src.wifipeer import (BCAST, IE_RATES, IE_SSID, LLC_SNAP, MGMT_ASSOC_RESP, MGMT_AUTH, MGMT_BEACON,
+                          MGMT_PROBE_REQ, RATES_BG, fc_fields, ie, str2mac)
+
+DEVICE = str2mac("12:34:56:ab:cd:01")      # the device as a station
+DEVICE_AP = str2mac("12:34:56:ab:cd:02")   # the device's own network
+HOME, VISITOR = str2mac("02:00:00:00:00:01"), str2mac("02:00:00:00:00:02")
+
+
+def on_air():
+    """An emulator with the home network's access point and a station for the
+    device's own network, on a clock the test moves, each peer's frames to
+    the device kept."""
+    emu = BekenEmulator(b"\xff" * 0x20000, None, b"", only_uart=True, wifi=True)
+    emu.setup()
+    home = emu.attach_wifi_peer(role="ap", ssid="HomeNet", peer_mac=HOME)
+    visitor = emu.attach_wifi_peer(role="sta", peer_mac=VISITOR)
+    clock = [0]
+    sent = {home.mac: [], visitor.mac: []}
+    for peer in (home, visitor):
+        peer.now_us = lambda: clock[0]
+        peer.latency_us = 0
+        peer.inject = lambda f, decr=None, mine=sent[peer.mac]: mine.append(f)
+    return emu, home, visitor, clock, sent
+
+
+def beacon(ssid):
+    body = struct.pack("<QHH", 0, 100, 0x0421) + ie(IE_SSID, ssid) + ie(IE_RATES, RATES_BG)
+    return wifipeer.WifiPeer(DEVICE_AP, None, None)._mgmt(MGMT_BEACON, BCAST, DEVICE_AP, DEVICE_AP, body)
+
+
+def joined(emu, visitor, clock):
+    """The station joined to the device's own network."""
+    emu._wifi_tx(beacon(b"esphome-000001"))
+    clock[0] += 100_000
+    visitor.tick()
+    emu._wifi_tx(visitor._mgmt(MGMT_AUTH, VISITOR, DEVICE_AP, DEVICE_AP, struct.pack("<HHH", 0, 2, 0)))
+    emu._wifi_tx(visitor._mgmt(MGMT_ASSOC_RESP, VISITOR, DEVICE_AP, DEVICE_AP, struct.pack("<HHH", 0x0421, 0, 0xC001)))
+    assert visitor.sta_state == "RUN"
+
+
+def test_a_second_peer_needs_a_mac_of_its_own():
+    emu, *_ = on_air()
+    try:
+        emu.attach_wifi_peer(role="sta", peer_mac=VISITOR)
+    except ValueError as e:
+        assert "a MAC of its own" in str(e)
+    else:
+        raise AssertionError("two peers with one MAC were accepted")
+    emu.close_network()
+
+
+def test_each_peer_hears_the_device_and_takes_its_own():
+    emu, home, visitor, clock, sent = on_air()
+    assert emu.wifi_peer is home and emu.wifi_peers == [home, visitor]
+    # The device looks for the home network: the access point answers, the
+    # station does not.
+    emu._wifi_tx(home._mgmt(MGMT_PROBE_REQ, BCAST, DEVICE, BCAST, ie(IE_SSID, b"HomeNet") + ie(IE_RATES, RATES_BG)))
+    assert sent[home.mac] and not sent[visitor.mac]
+    # The device's own network: the station joins it; the access point is
+    # still the home network's.
+    joined(emu, visitor, clock)
+    assert home.active_role == "ap" and home.ssid == "HomeNet"
+    # Data on the device's own network reaches the station alone, and the
+    # device's data to the home network the access point alone.
+    from_own = visitor._data(BCAST, DEVICE_AP, DEVICE_AP, LLC_SNAP + b"\x08\x06" + bytes(28), to_ds=False)
+    got = []
+    visitor.net.input = got.append
+    home.net.input = lambda eth: got.append(("home", eth))
+    emu._wifi_tx(from_own)
+    assert got == [BCAST + DEVICE_AP + b"\x08\x06" + bytes(28)]
+    home.stations[DEVICE] = {"state": "ASSOC", "aid": 1}
+    emu._wifi_tx(home._data(BCAST, DEVICE, HOME, LLC_SNAP + b"\x08\x06" + bytes(28), to_ds=True))
+    assert got[1][0] == "home" and len(got) == 2
+    # A frame from another network's access point is not the station's.
+    stranger = str2mac("12:34:56:ab:cd:09")
+    emu._wifi_tx(visitor._data(BCAST, stranger, stranger, LLC_SNAP + b"\x08\x06" + bytes(28), to_ds=False))
+    assert len(got) == 2
+    emu.close_network()
+    assert emu.wifi_peers == [] and emu.wifi_peer is None
+
+
+def test_the_station_loses_a_network_that_stops_beaconing():
+    emu, home, visitor, clock, sent = on_air()
+    joined(emu, visitor, clock)
+    clock[0] += wifipeer.BEACON_LOSS_US // 2
+    emu._wifi_tx(beacon(b"esphome-000001"))
+    clock[0] += wifipeer.BEACON_LOSS_US // 2 + 1
+    visitor.tick()
+    assert visitor.sta_state == "RUN", "lost while it still beacons"
+    clock[0] += wifipeer.BEACON_LOSS_US + 1
+    visitor.tick()
+    assert visitor.bss is None and visitor.sta_state == "SCAN"
+    # Up again, the station joins it again.
+    joined(emu, visitor, clock)
+    emu.close_network()
+
+
+def test_an_access_point_off_the_air_is_silent_until_back():
+    emu, home, visitor, clock, sent = on_air()
+    home.stations[DEVICE] = {"state": "ASSOC", "aid": 1}
+    home.set_on_air(False)
+    assert not home.stations
+    sent[home.mac].clear()
+    clock[0] += 1_000_000
+    home.tick()
+    emu._wifi_tx(home._mgmt(MGMT_PROBE_REQ, BCAST, DEVICE, BCAST, ie(IE_SSID, b"HomeNet") + ie(IE_RATES, RATES_BG)))
+    home.send_eth(BCAST + HOME + b"\x08\x06" + bytes(28))
+    assert sent[home.mac] == [], "off the air, it beacons, answers or sends nothing"
+    home.set_on_air(True)
+    clock[0] += 1_000_000
+    home.tick()
+    assert [fc_fields(f)[1] for f in sent[home.mac]] == [MGMT_BEACON] and home.active_role == "ap"
+    emu.close_network()
+
+
+def main():
+    test_a_second_peer_needs_a_mac_of_its_own()
+    test_each_peer_hears_the_device_and_takes_its_own()
+    test_the_station_loses_a_network_that_stops_beaconing()
+    test_an_access_point_off_the_air_is_silent_until_back()
+    print("Wi-Fi peers self-tests passed.")
+
+
+if __name__ == "__main__":
+    main()
