 src/emulator.py    | 13 ++++++++---
 tests/self_test.py | 25 ++++++++++++---------
 tests/slow_tick.py | 54 ++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 79 insertions(+), 13 deletions(-)
 create mode 100644 tests/slow_tick.py

diff --git a/src/emulator.py b/src/emulator.py
index 43071aa..4525ddc 100644
--- a/src/emulator.py
+++ b/src/emulator.py
@@ -199,3 +199,3 @@ class SimulatorState:
         self.last_pc = 0           # start of the last basic block, for the GUI status bar
-        self.last_slow = 0         # insn_count at last slow (timer) tick
+        self.last_slow = 0         # insn_count the last slow (timer) tick was due at
         self.last_fast = 0         # insn_count at last ~1000-insn (UART) tick
@@ -2060,5 +2060,12 @@ class BekenEmulator:
 
-        # Slow tick: raise the periodic sources' pending.
+        # Slow tick: raise the periodic sources' pending. Each is due
+        # SLOW_TICK_INSNS after the last was due, not after the chunk it was
+        # raised in ended: a chunk that crosses between ARM and Thumb steps
+        # the clock by 420 or 2381, not 1000, and counting from its end
+        # dropped what it overshot by. The guest's RTOS tick, raised here,
+        # then ran 5% slow against insn_count, which the rest of the device
+        # keeps, and up to 9% under a stream of interrupts, each entered and
+        # left by such a crossing.
         if state.insn_count - state.last_slow >= SLOW_TICK_INSNS:
-            state.last_slow = state.insn_count
+            state.last_slow += SLOW_TICK_INSNS
             if self.meter_cf_pin is not None or self.meter_cf1_pin is not None:
