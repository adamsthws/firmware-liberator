diff --git a/tests/slow_tick.py b/tests/slow_tick.py
new file mode 100644
index 0000000..497812b
--- /dev/null
+++ b/tests/slow_tick.py
@@ -0,0 +1,54 @@
+"""The slow tick, which raises the guest's RTOS timer, keeps the device clock:
+one tick each SLOW_TICK_INSNS of insn_count, however the chunks step it."""
+
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from src.emulator import BekenEmulator, SLOW_TICK_INSNS
+
+
+def ticks_over(steps, rounds):
+    """How many times the slow tick raises Timer 3's status while insn_count
+    moves by `steps`, `rounds` times over, the ISR acknowledging each; and
+    how many periods insn_count moved by."""
+    emu = BekenEmulator(b"\xff" * 0x20000, None, b"", only_uart=True)
+    emu.setup()
+    state = emu.state
+    state.icu_int_enable |= 1 << 8          # BKTIMER
+    raised = 0
+    for _ in range(rounds):
+        for step in steps:
+            state.insn_count += step
+            emu._pacing(state)
+            if state.timer3_5_ctl & (1 << 7):
+                raised += 1
+                state.timer3_5_ctl &= ~(1 << 7)
+    return raised, state.insn_count // SLOW_TICK_INSNS
+
+
+def test_a_tick_each_period_of_whole_chunks():
+    raised, periods = ticks_over([1000], 10_000)
+    assert raised == periods, (raised, periods)
+
+
+def test_a_tick_each_period_when_chunks_cross_between_arm_and_thumb():
+    # A chunk ending in the other state than it began in steps the clock by
+    # 420 (ARM to Thumb) or 2381 (Thumb to ARM), as one taking an interrupt
+    # or returning from it does: what a tick lands past its period counts
+    # towards the next, not lost.
+    raised, periods = ticks_over([1000, 420, 2381, 1000, 1000, 420, 1000], 2_000)
+    assert raised == periods, (raised, periods)
+
+
+def main():
+    test_a_tick_each_period_of_whole_chunks()
+    test_a_tick_each_period_when_chunks_cross_between_arm_and_thumb()
+    print("Slow tick self-tests passed.")
+
+
+if __name__ == "__main__":
+    main()
