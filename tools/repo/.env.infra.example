# The maintainer's tokens and private settings for the project's services,
# read by the tools beside it: cloudflare_settings.py, github_settings.py and
# readouts.py (website/README.md says which token). Kept apart from .env,
# which the tool reads and which refuses a name it does not know, and out of
# every emulator, which copies only what git tracks or would.
#
# Copy this file to .env.infra beside it (which git ignores), fill it in, and
# keep it to yourself:  chmod 600 tools/repo/.env.infra
# Names set in the environment win over the file.
# Only what a tool reads again and again belongs here: a secret needed once,
# or able to make others, a tool asks for at a hidden prompt and keeps
# nowhere.

# readouts.py's Cloudflare token, made and put here by
# tools/repo/cloudflare_tokens.py (TOKENS in cloudflare_settings.py says what
# it is allowed). cloudflare_settings.py asks for its own each run.
CLOUDFLARE_READOUTS_REVIEW_TOKEN=

# The machines that run the emulator suites, as ssh names them, space-separated:
# cloudflare_settings.py copies the suites' credentials to each when it makes
# or rotates them, as tools/repo/emulator_stats.py push does.
EMULATOR_STATS_HOSTS=

# The one address the admin view (website/admin/) lets in, if not the one
# the domain's mail is forwarded to (cloudflare_settings.py email sets that,
# kept in Email Routing alone).
ACCESS_ADMIN_EMAIL=
